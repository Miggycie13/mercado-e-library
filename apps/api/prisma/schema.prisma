generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  downloads    DownloadLog[]
  favorites    Favorite[]
  libraryItems LibraryItem[]
}

model Book {
  id           String        @id @default(cuid())
  title        String
  author       String
  category     String
  year         Int
  language     String        @default("English")
  description  String
  sourceUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  downloads    DownloadLog[]
  favorites    Favorite[]
  libraryItems LibraryItem[]

  @@unique([title, author])
  @@index([category])
  @@index([author])
}

model DownloadLog {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKey  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([guestKey])
  @@index([bookId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
}

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
}
